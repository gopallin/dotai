{
  "dotai-stop-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "bash ~/.gemini/hooks/stop-guard.sh",
        "timeout": 30
      }
    ]
  },
  "dotai-grounding-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|edit_notebook",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.gemini/hooks/grounding-guard.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "dotai-read-dedup-guard": {
    "PreToolUse": [
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.gemini/hooks/read-dedup-guard.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "dotai-branch-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.gemini/hooks/shared-guard-adapter.sh ~/.gemini/hooks/shared/branch-guard.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "dotai-glab-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.gemini/hooks/shared-guard-adapter.sh ~/.gemini/hooks/shared/glab-guard.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "dotai-complexity-guard": {
    "PreToolUse": [
      {
        "matcher": "grep_search|view_file|view_file_outline|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.gemini/hooks/shared-guard-adapter.sh ~/.gemini/hooks/shared/complexity-guard.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "dotai-context-budget-guard": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ~/.gemini/hooks/context-budget-guard.sh",
        "timeout": 30
      }
    ]
  }
}
